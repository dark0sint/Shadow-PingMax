# Salin menjadi .env lalu sesuaikan
PORT=3000
HOST=0.0.0.0

# WAJIB diisi bila server dibuka ke internet
ACCESS_PASSWORD=ganti-dengan-password-kuat
SESSION_SECRET=ganti-dengan-string-acak-panjang

# Aktifkan bila di belakang Nginx/Caddy/Cloudflare
TRUST_PROXY=0
COOKIE_SECURE=0

MAX_URLS=20
CONCURRENCY=10
PING_TIMEOUT_MS=12000
RATE_LIMIT_JOBS=15
RATE_WINDOW_MIN=60
MAX_ACTIVE_JOBS=3

# Izinkan UI dari GitHub Pages (pisahkan dengan koma), mis. https://usernama.github.io
# Jangan pakai * tanpa ACCESS_PASSWORD
CORS_ORIGIN=
